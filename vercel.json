{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{app.py,bg_remove.py,static/**,model_config.json}",
      "excludeFiles": "{data/**,certs/**,.ark_api_key,.gemini_api_key,docs/**,*.pdf,*.png}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
